# Grok Search MCP Service Environment Configuration
# Loopback HTTP transport
GROK_SEARCH_MCP_TRANSPORT=http
GROK_SEARCH_MCP_HOST=127.0.0.1
GROK_SEARCH_MCP_PORT=8800
GROK_SEARCH_MCP_PATH=/mcp
# Public client endpoint advertised by get_config_info; does not affect loopback routing.
GROK_SEARCH_MCP_PUBLIC_URL={{PUBLIC_MCP_URL}}

# Token verification via internal gateway endpoint
GROK_SEARCH_MCP_VERIFY_URL=http://127.0.0.1:8080/internal/keys/verify

# Provisioned out-of-band: shared secret with code-guda-gateway (matches GUDA_INTERNAL_TOKEN)
# DO NOT commit real secrets to git. Example format: internal_...
GROK_SEARCH_MCP_INTERNAL_TOKEN=

# Gateway upstream base URL and machine API key for GrokSearch calling guda-gateway
GUDA_BASE_URL=http://127.0.0.1:8080
# Machine key created in code-guda-gateway /admin/gateway-keys (e.g. named fastmcp-kr01)
GUDA_API_KEY=

# uv / CPython must not live under /root: ProtectHome=true blocks it.
UV_CACHE_DIR=/opt/GrokSearch/.cache
UV_PYTHON_INSTALL_DIR=/opt/uv-python

# Note: Do not set GROK_SEARCH_MCP_TOKEN in production (verify mode is enabled via VERIFY_URL).
