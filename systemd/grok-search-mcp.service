[Unit]
Description=Grok Search MCP Service (FastMCP HTTP)
After=network.target

[Service]
Type=simple
User=groksearch
Group=groksearch
WorkingDirectory=/opt/GrokSearch
EnvironmentFile=/etc/grok-search-mcp.env
# Loopback bind only (127.0.0.1:8800). Use the venv console script, not
# `uv run`: uv's managed CPython and the uv binary itself must not live
# under /root (ProtectHome=true cannot follow those paths).
ExecStart=/opt/GrokSearch/.venv/bin/grok-search
Restart=always
RestartSec=5

# Hardening directives
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
ReadWritePaths=/opt/GrokSearch /opt/uv-python

[Install]
WantedBy=multi-user.target
